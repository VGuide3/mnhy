{
  "name": "@web3-forge/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Build worker that produces esbuild artifacts and signed manifests.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch dist/server.js",
    "start": "node dist/server.js",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@web3-forge/shared": "workspace:*"
  }
}
